{
  "name": "whitney",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/run-dev.sh",
    "dev:api": "bun --watch app/index.ts",
    "dev:web": "vite",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "start": "bun app/index.ts",
    "migrate": "bun app/migrate.ts",
    "test": "bun test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@mantine/core": "^8.1.2",
    "@mantine/form": "^8.1.2",
    "@mantine/hooks": "^8.1.2",
    "@tabler/icons-react": "^3.34.0",
    "effect": "^3.22.2",
    "elysia": "^1.4.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
