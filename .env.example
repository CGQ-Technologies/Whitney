# Ports used by Bun's API server and the Vite development server.
BACKEND_PORT=3001
FRONTEND_PORT=5173
# Set BACKEND_HOST only if you intentionally want the API reachable from other devices.
# BACKEND_HOST=127.0.0.1

# Optional location for SQLite and whiteboard files (defaults to ./data).
# DATA_DIR=/absolute/path/to/whitney-data
